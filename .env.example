# Copy to .env and edit. Never commit .env.
# Every setting maps to app/settings.py (pydantic-settings, case-insensitive).

# Environment: "dev" or "prod". Outside dev the app refuses to start unless APP_PASSWORD is at
# least 12 characters and SECRET_KEY is a random value of at least 32 characters. The Docker
# image defaults to APP_ENV=prod; local runs opt into dev here.
APP_ENV=dev

# The single login password. Empty + APP_ENV=dev disables the login gate entirely (local dev
# only; the app logs a warning at startup). Five wrong guesses from one address lock that
# address out with an exponential backoff.
APP_PASSWORD=

# Signs the 30-day session cookie. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# Rotating SECRET_KEY (or changing APP_PASSWORD) invalidates every session cookie ever issued.
# On Fly: fly secrets set SECRET_KEY=$(python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=dev-secret-change-me

# SQLAlchemy URL. SQLite file path; the parent directory is created on first start.
# Fly.io uses sqlite:////data/app.db (persistent volume mounted at /data).
DATABASE_URL=sqlite:///./data/app.db

# The Odds API key (https://the-odds-api.com, free tier 500 credits/month). Optional.
# When empty, book refreshes fall back to the ESPN scoreboard (single low-weight book).
ODDS_API_KEY=

# Polymarket US programmatic access, for importing your own fills into the ledger.
# Create these at polymarket.us/developer (identity verification required); the secret is
# shown once. Leave both blank and the importer stays off -- market data needs no key.
# Read-only: the app never places, cancels or sizes an order.
PM_US_API_KEY=
PM_US_API_SECRET=

# true = seed synthetic fixture data on startup so every screen works without any API.
# Switching it off later does not remove the two synthetic demo bets from the ledger:
# run `python -m app.cli demo-clear` before going live.
DEMO_MODE=false

# In-process scheduler. 0 disables. Polymarket refresh is free; book refresh costs credits.
# The scheduler lives inside the web process, so it only runs while that process is up:
# with fly.toml's auto_stop_machines / min_machines_running = 0 the machine sleeps when
# nobody is using the app and NO scheduled scan fires. To use it on Fly set
# min_machines_running = 1 (about $2/month for the always-on machine); or leave both at
# 0 and run `python -m app.cli scan --kind books` from an external cron instead.
SCHEDULER_POLY_MINUTES=0
SCHEDULER_BOOKS_HOURS=0

# Header carrying the real client IP, set ONLY if a proxy you control adds it and
# overwrites anything the client sent (Fly.io: fly-client-ip). Empty = trust nothing but
# the socket peer. A forgeable header here would let one client reset the login lockout by
# rotating its value.
TRUSTED_PROXY_HEADER=

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Directory holding the synthetic JSON fixtures (defaults to <repo>/fixtures).
# FIXTURES_DIR=/app/fixtures
